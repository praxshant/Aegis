# Aegis Environment Variables

# Database (optional - defaults to local sqlite)
DATABASE_URL=sqlite:///backend/data/aegis.db

# LLM Agent
GEMINI_API_KEY=your_gemini_api_key_here

# Auth (WS1). Set JWT_SECRET_KEY to a long random string; without it the API
# runs with an ephemeral per-process key and tokens die on restart.
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Execution / Razorpay
RAZORPAY_KEY_ID=rzp_test_example_key_here
RAZORPAY_KEY_SECRET=rzp_test_example_secret_here

# Frontend
STREAMLIT_SERVER_PORT=8501
API_URL=http://localhost:8000
