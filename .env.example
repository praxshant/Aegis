# Aegis Environment Variables

# Database (optional - defaults to backend/data/aegis.db; relative paths resolve
# against the project root, not the directory you start the server from)
DATABASE_URL=sqlite:///backend/data/aegis.db

# LLM Agent
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash          # pin a model; otherwise auto-selected
# OLLAMA_URL=http://localhost:11434      # fallback LLM when Gemini is unset/unavailable
# OLLAMA_MODEL=llama3.2:3b

# Auth (WS1). Set JWT_SECRET_KEY to a long random string; without it the API
# runs with an ephemeral per-process key and tokens die on restart.
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Execution / Razorpay (test keys; without them a mock adapter is used).
# rzp_live_ keys are refused unless RAZORPAY_ENV=live.
RAZORPAY_KEY_ID=rzp_test_example_key_here
RAZORPAY_KEY_SECRET=rzp_test_example_secret_here
RAZORPAY_ENV=test
# RAZORPAY_WEBHOOK_SECRET=...            # enables POST /webhooks/razorpay

# Uploads
MAX_UPLOAD_MB=50

# Container boot (deploy/bootstrap.py): accounts created/updated on every start
# AEGIS_ADMIN_PASSWORD=...               # user "admin" (AEGIS_ADMIN_USERNAME to rename)
# AEGIS_DEMO_PASSWORD=...                # optional shareable "demo" operator
# AEGIS_SEED_DEMO=1                      # seed demo customers when the DB is empty

# Frontend (Streamlit dashboard -> API)
STREAMLIT_SERVER_PORT=8501
API_URL=http://127.0.0.1:8000
# Which UI the container exposes on $PORT: "dashboard" (Streamlit) or "console" (HTML console + API)
# AEGIS_PUBLIC_UI=dashboard
