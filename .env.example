# Aegis Environment Variables

# Database (optional - defaults to local sqlite)
DATABASE_URL=sqlite:///backend/data/aegis.db

# LLM Agent
GEMINI_API_KEY=your_gemini_api_key_here

# Execution / Razorpay
RAZORPAY_KEY_ID=rzp_test_example_key_here
RAZORPAY_KEY_SECRET=rzp_test_example_secret_here

# Frontend
STREAMLIT_SERVER_PORT=8501
API_URL=http://localhost:8000
